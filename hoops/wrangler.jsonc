// Cloudflare Workers config. The game is a static site, so the Worker is
// just its built files in dist/, served as static assets.
//
// The repository is connected to the "admiral" Worker with Workers Builds,
// rooted at hoops/: pushes to master deploy production (wrangler deploy),
// and pushes to any other branch create or update that branch's Preview
// (wrangler preview). The name here must match the Worker's name in the
// Cloudflare dashboard, or the build fails.
{
  "name": "admiral",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist"
  },
  // Previews use the same settings as production: there are no bindings,
  // variables or secrets to keep apart.
  "previews": {}
}
